# Copy to .env and adjust:  cp .env.example .env
# run_local.sh and docker-compose.yml both read this file. Never commit .env.

# ---- API ------------------------------------------------------------------
# Optional API key. When set, every /v1/* request needs header X-API-Key.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated list of allowed browser origins (the dashboard).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Requests per minute per client (API key or IP). 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=120
MAX_INPUT_CHARS=20000
MAX_BODY_BYTES=256000
MAX_TRACE_STEPS=5000
# Allow enabling/disabling/adding rules through the API and dashboard.
# Changes are validated, compiled, and written atomically to PATTERNS_PATH.
RULE_EDITING_ENABLED=true

# ---- Configuration files (relative to the project root) --------------------
PATTERNS_PATH=config/patterns.json
POLICIES_PATH=config/policies.json
CORPUS_PATH=evaluation/corpus.json

# ---- Audit log --------------------------------------------------------------
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_MAX_BYTES=5000000
AUDIT_BACKUP_COUNT=5
# Store a SHA-256 of each input (correlation without storing text).
AUDIT_HASH_INPUT=true
# If set, an HMAC-SHA256 keyed with this secret is stored instead (resists guessing).
AUDIT_HASH_KEY=
# DANGER: writes raw prompts to the audit log. Leave false.
AUDIT_LOG_RAW_INPUT=false
AUDIT_LOG_CLIENT_IP=false

# ---- Dashboard --------------------------------------------------------------
# Where the dashboard finds the API (docker-compose overrides this to http://api:8000).
API_URL=http://127.0.0.1:8000
