    {
      "id": "II-001",
      "name": "Text addressed to an AI reader",
      "category": "INDIRECT_INJECTION",
      "severity": "medium",
      "enabled": true,
      "description": "Embedded content (document, web page, e-mail) that addresses an AI system directly, a typical marker of indirect prompt injection.",
      "patterns": [
        "note to ai",
        "note to assistant",
        "attention ai",
        "ai assistant reading",
        "if you are an ai",
        "if you are language model",
        "instructions for ai",
        "message for ai",
        "when summarizing document",
        "when you summarize",
        "assistant must now",
        "hidden instruction"
      ]
    },
    {
      "id": "II-002",
      "name": "Fake system / role markers",
      "category": "INDIRECT_INJECTION",
      "severity": "medium",
      "enabled": true,
      "description": "Fake conversation or system delimiters inserted into content to impersonate a higher-privilege message.",
      "patterns": [
        "begin system prompt",
        "end system prompt",
        "system override",
        "new system instructions",
        "admin override",
        "im start system",
