    {
      "id": "DE-001",
      "name": "Reveal confidential data",
      "category": "DATA_EXFILTRATION",
      "severity": "high",
      "enabled": true,
      "description": "Asks the model to reveal secrets, credentials or confidential information.",
      "patterns": [
