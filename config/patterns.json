    {
      "id": "PM-001",
      "name": "Instruction priority claim",
      "category": "PRIORITY_MANIPULATION",
      "severity": "medium",
      "enabled": true,
      "description": "Claims that this text takes priority over, overrides or supersedes other instructions.",
      "patterns": [
