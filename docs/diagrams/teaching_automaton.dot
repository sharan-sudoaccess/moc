digraph teaching_automaton {
  graph [rankdir=LR fontname="Helvetica" bgcolor="white" pad=0.3 nodesep=0.4 ranksep=0.7 label="Teaching automaton for P1..P4 (solid: trie edges / goto, dashed red: failure links; every omitted failure link goes to q0)" labelloc=b fontsize=11];
  node [shape=circle fontname="Helvetica" fontsize=10 width=0.9 fixedsize=false];
  edge [fontname="Helvetica" fontsize=10];
  start [shape=point width=0.1]; start -> q0;
  q0 [shape=circle label="q0\nε"];
  q1 [shape=circle label="q1\nignore"];
  q2 [shape=circle label="q2\nprompt"];
  q3 [shape=circle label="q3\nreveal"];
  q4 [shape=circle label="q4\nsystem"];
  q5 [shape=circle label="q5\nignore previous"];
  q6 [shape=doublecircle style=filled fillcolor="#FDE2E4" label="q6\nprompt verbatim\n{P4}"];
  q7 [shape=circle label="q7\nreveal system"];
  q8 [shape=doublecircle style=filled fillcolor="#FDE2E4" label="q8\nsystem prompt\n{P3}"];
  q9 [shape=doublecircle style=filled fillcolor="#FDE2E4" label="q9\nignore previous instructions\n{P1}"];
  q10 [shape=doublecircle style=filled fillcolor="#FDE2E4" label="q10\nreveal system prompt\n{P2, P3}"];
  q0 -> q1 [label="ignore" penwidth=1.4];
  q0 -> q2 [label="prompt" penwidth=1.4];
  q0 -> q3 [label="reveal" penwidth=1.4];
  q0 -> q4 [label="system" penwidth=1.4];
  q1 -> q5 [label="previous" penwidth=1.4];
  q2 -> q6 [label="verbatim" penwidth=1.4];
  q3 -> q7 [label="system" penwidth=1.4];
  q4 -> q8 [label="prompt" penwidth=1.4];
  q5 -> q9 [label="instructions" penwidth=1.4];
  q7 -> q10 [label="prompt" penwidth=1.4];
  q7 -> q4 [style=dashed color="#C0392B" arrowsize=0.6 constraint=false];
  q8 -> q2 [style=dashed color="#C0392B" arrowsize=0.6 constraint=false];
  q10 -> q8 [style=dashed color="#C0392B" arrowsize=0.6 constraint=false];
}
